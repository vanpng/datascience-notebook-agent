# Copy to .env and fill in values

# Model server — both backends expose an OpenAI-compatible API on VLLM_BASE_URL
VLLM_BASE_URL=http://localhost:8001/v1

# macOS (Apple Silicon): mlx-lm serves an MLX-quantised model
MLX_MODEL=mlx-community/Qwen3-4B-8bit

# Linux / tillicum (CUDA): vllm serves the HuggingFace model
VLLM_MODEL=Qwen/Qwen3-4B

# FastAPI agent server
AGENT_API_HOST=127.0.0.1
AGENT_API_PORT=8000

# Code execution sandbox
SANDBOX_TIMEOUT=60          # seconds per cell
SANDBOX_MEMORY_MB=2048      # memory cap
MAX_DEBUG_ATTEMPTS=3

# Fine-tuned adapter (leave blank to use base model)
LORA_ADAPTER_PATH=


